DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/production_control
DEBUG=true
CELERY_BROKER_URL=amqp://production_control:production_control@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
WORK_CENTER_CACHE_TTL_SECONDS=60

# Local development only. Use separate credentials and HTTPS for deployment.
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ROOT_USER=production_control
MINIO_ROOT_PASSWORD=local-minio-password
MINIO_SECURE=false
