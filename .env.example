DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/production_control
DEBUG=true
PRODUCTION_TIMEZONE=Asia/Yekaterinburg
CELERY_BROKER_URL=amqp://production_control:production_control@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0
FLOWER_BASIC_AUTH=admin:local-flower-password
REDIS_CACHE_URL=redis://localhost:6379/1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_WRITE_REQUESTS=60
RATE_LIMIT_BACKGROUND_REQUESTS=10
WORK_CENTER_CACHE_TTL_SECONDS=60
BATCH_STATISTICS_CACHE_TTL_SECONDS=300
DASHBOARD_CACHE_TTL_SECONDS=300
BATCH_LIST_CACHE_TTL_SECONDS=60
BATCH_DETAILS_CACHE_TTL_SECONDS=600

# Local development only. Use separate credentials and HTTPS for deployment.
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ROOT_USER=production_control
MINIO_ROOT_PASSWORD=local-minio-password
MINIO_SECURE=false
MINIO_IMPORT_RETENTION_DAYS=7
MINIO_EXPORT_RETENTION_DAYS=7
MINIO_REPORT_RETENTION_DAYS=30

# Local SMTP mailbox: http://localhost:8025 (Mailpit in Docker Compose).
PUBLIC_API_URL=http://localhost:8000
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_FROM_EMAIL=reports@production-control.local
# For external delivery, set SMTP_HOST, SMTP_USERNAME and SMTP_PASSWORD,
# and use SMTP_SECURITY=starttls (usually port 587) or ssl (usually port 465).
